# ==========================================
# 🌙 NUR HATM - CONFIGURATION
# ==========================================

# --- TELEGRAM BOT ---
BOT_TOKEN=8000000000:AAH_your_telegram_bot_token_here
# Comma-separated Telegram User IDs of Super Admins
ADMIN_IDS=123456789,987654321
# Optional: Telegram Channel ID (e.g. -1001234567890 or @your_channel) for live Hatm board updates
CHANNEL_ID=-1001234567890
# Public URL of the deployed Mini App (Vercel URL)
WEBAPP_URL=https://nur-hatm-bot.vercel.app

# --- DATABASE (Neon.tech Free PostgreSQL or Local SQLite/Postgres) ---
# For Neon.tech: postgresql+asyncpg://user:pass@ep-cool-darkness-123456.eu-central-1.aws.neon.tech/neondb?ssl=require
# For local instant testing without Postgres: sqlite+aiosqlite:///./hatm_local.db
DATABASE_URL=sqlite+aiosqlite:///./hatm_local.db

# --- HATM & RATING RULES ---
DEFAULT_TIMER_HOURS=24
POINTS_ON_COMPLETE=10
POINTS_ON_EXPIRE_PENALTY=5
CHANNEL_DEBOUNCE_SECONDS=3

# --- SERVER ---
PORT=8000
CORS_ORIGINS=*
VITE_API_URL=http://localhost:8000/api
